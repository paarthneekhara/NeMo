#!/bin/bash
#SBATCH -t 1:00:00              # wall time
#SBATCH --ntasks-per-node=8        # tasks per node
#SBATCH --exclusive                # exclusive node access
#SBATCH --mem=0                    # all mem avail
#SBATCH --mail-type=FAIL           # only send email on failure
#SBATCH --overcommit               # Needed for pytorch
#SBATCH -p batch
#SBATCH -N 1                       # number of nodes
#SBATCH -A 	convai_convaird_nemo-speech
#SBATCH -J 	convai_convaird_nemo-speech-sample:cer_ssim_it

source containers_magpie.sh
export HYDRA_FULL_ERROR=1

set -x

CODE_DIR="/gitrepos/NeMo"
DEVICES=8
BATCH_SIZE=16
LOG_LEVEL="INFO"

EXP_DIR="/lustre/fsw/llmservice_nemo_speechlm/users/pneekhara/gitrepos/Experiments2026/CER_SSIM_Annotation/it"
mkdir -p $EXP_DIR

read -r -d '' cmd <<EOF
echo "*******STARTING CER/SSIM ANNOTATION FOR it********" \
&& export HF_HOME="/gitrepos/huggingface" \
&& cd ${CODE_DIR} ; export PYTHONPATH="${CODE_DIR}:${PYTHONPATH}" \
&& echo ">>> [it] Processing dataset 1/1: it/cmltts_it_train/cuts_with_ipa" \
&& python -u ${CODE_DIR}/scripts/magpietts/annotate_lhotse_shards_with_cer_ssim.py \
    --cuts-dir /data/speech_data/it/cmltts_it_train/cuts_with_ipa \
    --target-audio-dir /data/speech_data/it/cmltts_it_train/target_audio \
    --context-audio-dir /data/speech_data/it/cmltts_it_train/context_audio \
    --output-dir /data/speech_data/it/cmltts_it_train/cuts_with_ipa_annotated \
    --devices ${DEVICES} \
    --num-nodes ${SLURM_JOB_NUM_NODES} \
    --batch-size ${BATCH_SIZE} \
    --log-level ${LOG_LEVEL}
EOF

echo $cmd

srun -o ${EXP_DIR}/slurm-cer-ssim-%j-%n.out -e ${EXP_DIR}/slurm-cer-ssim-%j-%n.err --no-container-mount-home --container-image="$CONTAINER" $MOUNTS bash -c "${cmd}"
set +x
