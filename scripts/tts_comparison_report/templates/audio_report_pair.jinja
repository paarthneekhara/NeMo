<div class="audio-pair-card">
  <div class="audio-pair-row">
    <div class="audio-cell">
      <div class="lazy-audio" data-audio-src="{{ context_url }}">
        <button type="button" class="load-audio-button">Load audio</button>
      </div>
    </div>
    <div class="audio-cell">
      <div class="lazy-audio" data-audio-src="{{ baseline_url }}">
        <button type="button" class="load-audio-button">Load audio</button>
      </div>
    </div>
    <div class="audio-cell">
      <div class="lazy-audio" data-audio-src="{{ candidate_url }}">
        <button type="button" class="load-audio-button">Load audio</button>
      </div>
    </div>
  </div>
  <p class="pair-comment">
    Text: {{ text }}
  </p>
</div>